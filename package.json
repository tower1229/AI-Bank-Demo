{
  "name": "ai-bank-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply ai-bank-demo-db --local",
    "db:seed:local": "wrangler d1 execute ai-bank-demo-db --local --file=./scripts/seed.sql",
    "db:migrate:remote": "node ./scripts/wrangler-env.mjs d1 migrations apply ai-bank-demo-db --remote",
    "db:seed:remote": "node ./scripts/wrangler-env.mjs d1 execute ai-bank-demo-db --remote --file=./scripts/seed.sql",
    "deploy": "node ./scripts/deploy.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.1.0",
    "wrangler": "^4.42.0"
  }
}
