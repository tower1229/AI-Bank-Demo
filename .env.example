# Copy to .env or .dev.vars locally. Do not commit real values.

# Cloudflare Worker / MCP
BANK_MCP_SECRET=replace_with_generated_secret

# OpenClaw server-side setup, not used directly by the bank Worker unless a local script needs it.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
OPENCLAW_AI_BANK_AGENT_ID=ai-bank
OPENCLAW_TELEGRAM_ACCOUNT_ID=ai-bank-demo

# Cloudflare D1 reference. The actual database_id belongs in wrangler.toml once the Worker is implemented.
CLOUDFLARE_D1_DATABASE_NAME=ai-bank-demo-db
CLOUDFLARE_D1_DATABASE_ID=replace_with_d1_database_id
